# Energy Geopolitics Intelligence Platform - Environment Configuration

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./energy_intel.db

# Recovery Stack
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2.0
CHECKPOINT_DIR=./checkpoints

# Data Sources (API keys - replace with real values)
EIA_API_KEY=your_eia_api_key_here
NEWS_API_KEY=your_news_api_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Risk Thresholds
HIGH_RISK_THRESHOLD=0.7
CRITICAL_RISK_THRESHOLD=0.85

# Alert Configuration
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Seed Data
LOAD_SEED_DATA=true
